# Copy to .env and fill in. NEVER commit .env.

# OpenRouter (default LiteLLM gateway for AgentGuard live tests)
OPENROUTER_API_KEY=

# Optional: pin a default model for the test suite
AGENTGUARD_DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4-5
AGENTGUARD_JUDGE_MODEL=openrouter/openai/gpt-4o-mini

# Optional: opt-in flags
AGENTGUARD_ALLOW_CODE_EXECUTION=false
AGENTGUARD_TELEMETRY=true
